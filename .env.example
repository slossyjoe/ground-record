# Optional. Ground Record runs without any of these.
# Leave this empty on your computer. The GitHub Pages workflow sets it to /ground-record.
NEXT_PUBLIC_BASE_PATH=
# Copy this file to .env and fill in only the services you want.
# Do not share the filled-in file. It is ignored by git.

# ACLED event data (locations and fatality counts recorded by ACLED).
# Create a free myACLED login, then put the email and password here.
# Guide: https://acleddata.com/api-documentation/getting-started
ACLED_EMAIL=
ACLED_PASSWORD=

# ReliefWeb humanitarian reports.
# Request an app name: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# Uppsala Conflict Data Program.
# Request a token: https://ucdp.uu.se/apidocs/
# The script sends it as the header x-ucdp-access-token.
UCDP_ACCESS_TOKEN=
